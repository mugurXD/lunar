body
{
	display: block;
	width: 100%;
	height: 100%;
	font-family: Inter;
	font-size: 18dp;
	color: #ffffff;
}

div
{
	display: block;
}

.money
{
	position: absolute;
	top: 24dp;
	right: 32dp;
	font-size: 34dp;
	font-weight: bold;
	font-effect: shadow(0dp 2dp #00000099);
	transform-origin: right top;
	transition: color transform 0.35s cubic-out;
}

.money.earned
{
	color: #8dffa0;
	transform: scale(1.12);
}

.payout
{
	position: absolute;
	top: 70dp;
	right: 32dp;
	font-size: 22dp;
	font-weight: 600;
	color: #8dffa0;
	font-effect: shadow(0dp 2dp #00000099);
	opacity: 0;
	transition: opacity 0.4s linear-out;
}

.payout.visible
{
	opacity: 1;
}

.job
{
	position: absolute;
	top: 24dp;
	left: 32dp;
	min-width: 220dp;
	padding: 14dp 18dp;
	border-radius: 10dp;
	background-color: #0b0f14b3;
}

.stage
{
	font-size: 14dp;
	font-weight: 600;
	color: #c7d2dc;
	text-transform: uppercase;
}

.reward
{
	margin-top: 4dp;
	font-size: 26dp;
	font-weight: bold;
}

.timer
{
	margin-top: 6dp;
	font-size: 16dp;
	color: #c7d2dc;
	transition: color 0.3s cubic-out;
}

.job.late .timer
{
	color: #ff6b5e;
}
